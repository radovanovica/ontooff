# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:root@localhost:5432/activity_tracking"

# ─────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-here"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────
SMTP_HOST="mail.bidtech.rs"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@bidtech.rs"
SMTP_PASSWORD="Bidtech123."
EMAIL_FROM="ontooff <noreply@bidtech.rs>"
SUPER_ADMIN_EMAIL="your-admin-email@gmail.com"

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ontooff"

# ─────────────────────────────────────────
# AI Chatbot (Google Gemini — free tier)
# Get key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────
# Groq API key (free tier: 14,400 req/day — get it at https://console.groq.com)
GROQ_API_KEY="your-groq-api-key-here"

# ─────────────────────────────────────────
# AWS S3 (image storage)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="eu-north-1"
AWS_S3_BUCKET="amzn-s3-ontooff-bucket"
